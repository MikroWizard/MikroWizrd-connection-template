{
  "changelog": [
    "Initial catalog revision (as installed by MikroWizard 2.1.x)"
  ],
  "content": {
    "brand": "hp",
    "commands": {
      "show_arp": "show arp",
      "show_config": "show running-config",
      "show_interfaces": "show interfaces",
      "show_log": "show logging",
      "show_routing": "show ip route",
      "show_version": "show version"
    },
    "config_mode": null,
    "connection": {
      "default_port_ssh": 22,
      "default_port_telnet": 23,
      "protocols": [
        "ssh"
      ],
      "timeout": 60
    },
    "diff_exclusions": {
      "global": [],
      "show_config": [
        {
          "flags": "i",
          "pattern": "^;\\s*Time:\\s*.*$"
        },
        {
          "flags": "i",
          "pattern": "^;\\s*Created on release.*$"
        },
        {
          "flags": "i",
          "pattern": "^;\\s*Configuration Editor.*$"
        }
      ]
    },
    "display_name": "H3C - SSH - No Enable",
    "error_patterns": {
      "patterns": [
        "Invalid input",
        "Error",
        "Unrecognized"
      ]
    },
    "os_type": "h3c-ssh",
    "pagination": {
      "enabled": true,
      "key": "space",
      "pattern": "--More--"
    },
    "post_disconnect": [],
    "post_login_commands": [
      "screen-length disable"
    ],
    "pre_connect": [],
    "pre_logout_commands": [
      "quit"
    ],
    "privilege_escalation": null,
    "prompt": {
      "login_pattern": "Username:",
      "password_pattern": "Password:",
      "patterns": [
        "\\S+#\\s*$",
        "\\S+>\\s*$"
      ]
    },
    "protocol": "ssh"
  },
  "edition": "free",
  "key": "hp/h3c-ssh",
  "min_app_version": "2.1.2",
  "previous_hashes": [],
  "revision": 1
}