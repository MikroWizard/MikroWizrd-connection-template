{
  "changelog": [
    "Initial catalog revision (as installed by MikroWizard 2.1.x)"
  ],
  "content": {
    "brand": "cisco",
    "commands": {
      "show_arp": "show arp",
      "show_config": "show running-config",
      "show_interfaces": "show interfaces",
      "show_log": "show logging",
      "show_routing": "show ip route",
      "show_version": "show version"
    },
    "config_mode": {
      "enter": "configure terminal",
      "exit": "end",
      "save": null
    },
    "connection": {
      "default_port_ssh": 22,
      "default_port_telnet": 23,
      "protocols": [
        "ssh",
        "telnet"
      ],
      "timeout": 60
    },
    "diff_exclusions": {
      "global": [
        {
          "flags": "",
          "pattern": "^!\\s*Last configuration change at.*$"
        },
        {
          "flags": "",
          "pattern": "^!\\s*NVRAM config last updated at.*$"
        },
        {
          "flags": "i",
          "pattern": "^!\\s*No configuration change since.*$"
        },
        {
          "flags": "i",
          "pattern": "^!\\s*Configuration last modified by.*$"
        },
        {
          "flags": "i",
          "pattern": "^.*uptime is.*$"
        }
      ],
      "show_config": [
        {
          "flags": "",
          "pattern": "^!\\s*Time:.*$"
        },
        {
          "flags": "",
          "pattern": "^Current configuration : \\d+ bytes$"
        },
        {
          "flags": "i",
          "pattern": "^Building configuration\\.\\.\\.$"
        }
      ]
    },
    "display_name": "Cisco IOS - SSH - No Enable",
    "error_patterns": {
      "patterns": [
        "% Invalid",
        "% Ambiguous",
        "Error"
      ]
    },
    "os_type": "ios-ssh-noenable",
    "pagination": {
      "enabled": true,
      "key": "space",
      "pattern": "--More--"
    },
    "post_disconnect": [],
    "post_login_commands": [
      "terminal length 0"
    ],
    "pre_connect": [],
    "pre_logout_commands": [
      "quit"
    ],
    "privilege_escalation": null,
    "prompt": {
      "login_pattern": "Username:",
      "password_pattern": "Password:",
      "patterns": [
        "\\S+#\\s*$",
        "\\S+>\\s*$"
      ]
    },
    "protocol": "ssh"
  },
  "edition": "free",
  "key": "cisco/ios-ssh-noenable",
  "min_app_version": "2.1.2",
  "previous_hashes": [],
  "revision": 1
}